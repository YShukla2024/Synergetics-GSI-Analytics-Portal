# ═══════════════════════════════════════════════════════════════════════════════
# GSI Analytics Portal — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Microsoft Entra ID user authentication (Auth.js / NextAuth v5) ─────────────
# Azure Portal → App registrations → <your portal app> → Overview
AZURE_CLIENT_ID=            # Application (client) ID
AZURE_CLIENT_SECRET=        # Certificates & secrets → client secret value
AZURE_TENANT_ID=            # Directory (tenant) ID

# Auth.js session cookie encryption secret.
# Generate one with:  npx auth secret
NEXTAUTH_SECRET=

# Base URL of this app. OPTIONAL in dev (the host header is trusted, so the
# URL is detected automatically). Set it in production so absolute callback
# URLs are built correctly, e.g. https://portal.example.com — and make sure it
# matches the host/port the app is actually served on.
NEXTAUTH_URL=

# ── RBAC (optional) ─────────────────────────────────────────────────────────────
# Map Entra security-group object IDs to portal roles.
# Format: comma-separated "groupId:Role" pairs.
# Roles: Admin, Manager, Trainer, Sales, Viewer
# AZURE_GROUP_ROLE_MAP="11111111-1111-1111-1111-111111111111:Admin,22222222-2222-2222-2222-222222222222:Manager"

# ── Power BI / Fabric embed (service principal — independent of user login) ─────
# Azure Portal → App registrations → <embed service principal> → Overview
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=       # Fabric/Power BI workspace GUID holding the report
POWERBI_REPORT_ID=          # Report GUID to embed

# Optional: RLS role names defined on the dataset (comma-separated), e.g. "Manager,Sales".
# Needed when the dataset demands an effective identity for embed tokens (row-level
# security or an on-premises gateway). The signed-in user is passed as the identity.
POWERBI_RLS_ROLES=
